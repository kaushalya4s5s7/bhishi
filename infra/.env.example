# Copy to infra/.env before `docker compose -f infra/docker-compose.yml up`.
# DATABASE_URL and REDIS_URL are set by compose to the in-network services;
# override them here to point at managed Postgres/Redis instead.

# ── chain ────────────────────────────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
FACTORY_ADDRESS=
# Factory's deploy block — indexing starts here, not genesis.
START_BLOCK=
POLL_INTERVAL_MS=10000

# ── api ──────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
CORS_ORIGINS=https://your-frontend.vercel.app
# Server-side Privy JWT verification (required for protected routes).
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── notify (unset = messages are logged, NOT delivered) ──────────────────
RESEND_API_KEY=
RESEND_FROM=noreply@bhishi.app
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
