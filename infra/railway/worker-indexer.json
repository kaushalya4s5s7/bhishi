{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @bhishi/db generate && pnpm --filter @bhishi/workers build"
  },
  "deploy": {
    "startCommand": "node apps/workers/dist/indexer.js",
    "restartPolicyType": "ON_FAILURE"
  }
}
