// Bhishi off-chain index + operational store.
//
// IMPORTANT: on-chain is the source of truth. Everything here is a derived,
// rebuildable cache — if this database is wiped, the indexer worker can fully
// reconstruct it by replaying getLogs from the factory's deploy block. No
// business logic may depend on Postgres alone; it exists for read performance
// and off-chain convenience (waitlist, notifications), never as the arbiter of
// fund state.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Mirrors Circle.sol's Mode enum (0 = LUCKY_DRAW, 1 = AUCTION).
enum CircleMode {
  LUCKY_DRAW
  AUCTION
}

/// Mirrors Circle.sol's State enum exactly, including ordinal position.
/// ACTIVE and PAYOUT are declared on-chain but never assigned (reserved /
/// payout happens inline) — kept here so ordinal mapping stays 1:1.
enum CircleState {
  FILLING
  ACTIVE
  ABORTED_FILLING
  COMMIT
  REVEAL
  DRAW
  PAYOUT
  COMPLETED
  STALLED
}

model Circle {
  /// Clone address — the on-chain identity, so it's the primary key.
  address      String      @id
  factoryTx    String
  creator      String
  seats        Int
  /// Token base units (mUSDC has 6 decimals). Decimal avoids float error.
  contribution Decimal     @db.Decimal(78, 0)
  bond         Decimal     @db.Decimal(78, 0)
  mode         CircleMode
  state        CircleState @default(FILLING)
  currentRound Int         @default(0)
  createdAt    DateTime
  /// Highest block whose logs are reflected in this row — the indexer's
  /// per-circle watermark, so a restart resumes instead of re-scanning.
  lastIndexedBlock BigInt  @default(0)

  members Member[]
  rounds  Round[]
  events  ChainEvent[]
  invites Invite[]

  @@index([state])
  @@index([creator])
}

model Member {
  id            String   @id @default(cuid())
  circle        Circle   @relation(fields: [circleAddress], references: [address], onDelete: Cascade)
  circleAddress String
  address       String
  joinedAt      DateTime
  hasWon        Boolean  @default(false)
  /// Set when a member is slashed out; they stay in the row for audit.
  slashed       Boolean  @default(false)

  @@unique([circleAddress, address])
  @@index([address])
}

model Round {
  id             String    @id @default(cuid())
  circle         Circle    @relation(fields: [circleAddress], references: [address], onDelete: Cascade)
  circleAddress  String
  roundNumber    Int
  phase          CircleState
  startedAt      DateTime?
  /// Deadlines derived from roundStart + COMMIT_WINDOW / REVEAL_WINDOW.
  commitDeadline DateTime?
  revealDeadline DateTime?
  /// Gelato VRF request handle, recorded by the keeper (B4).
  vrfRequestId    String?
  drawRequestedAt DateTime?
  winner          String?
  /// AUCTION only: winning bid discount, in token base units.
  winningDiscount Decimal? @db.Decimal(78, 0)

  @@unique([circleAddress, roundNumber])
  @@index([phase])
}

/// Append-only audit trail of every Circle event we've observed.
/// Unique on (txHash, logIndex) so re-indexing is idempotent.
model ChainEvent {
  id            String   @id @default(cuid())
  circle        Circle   @relation(fields: [circleAddress], references: [address], onDelete: Cascade)
  circleAddress String
  blockNumber   BigInt
  txHash        String
  logIndex      Int
  eventName     String
  payload       Json
  observedAt    DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([circleAddress, blockNumber])
}

/// Early-access intake — replaces the console.log-only Next.js route.
model WaitlistEntry {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  whatsapp       String?
  tradition      String?
  circleSize     Int?
  trackingMethod String?
  role           String?
  wantsTryNow    Boolean  @default(false)
  /// Wallet address if the submitter was authenticated (Privy).
  walletAddress  String?
  createdAt      DateTime @default(now())
}

/// Off-chain user profile. Unlike Circle/Member/Round (which are a rebuildable
/// mirror of chain state), this is genuinely off-chain data with no on-chain
/// source — display name, avatar, contact prefs. Keyed by the user's wallet
/// address (lowercased), the same identity used everywhere else in this schema.
/// Auto-created on first sign-in; editable by the owner via the API.
model UserProfile {
  /// Lowercased wallet address — the on-chain identity, so it's the primary key.
  walletAddress String   @id
  /// Privy DID, for cross-referencing the auth provider. Unique when present.
  privyUserId   String?  @unique
  email         String?
  displayName   String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastSeenAt    DateTime @default(now())
}

/// Audit trail of relayer-sponsored native-MON top-ups for circle creation.
/// Used to enforce a per-user daily cap (anti-drain) and to trace where the
/// relayer's funds went. One row per successful (or attempted) top-up.
model SponsorGrant {
  id            String   @id @default(cuid())
  /// The user's wallet address the top-up was sent to (lowercased).
  walletAddress String
  /// Native MON sent, in wei (Decimal to avoid float error).
  amountWei     Decimal  @db.Decimal(78, 0)
  txHash        String?
  status        String   @default("sent")
  createdAt     DateTime @default(now())

  @@index([walletAddress, createdAt])
}

/// Delivery audit + dedup/backoff state for the notify worker (B5).
model NotificationLog {
  id          String   @id @default(cuid())
  userAddress String?
  email       String?
  channel     String
  kind        String
  status      String   @default("queued")
  jobId       String?
  error       String?
  createdAt   DateTime @default(now())
  sentAt      DateTime?

  @@index([userAddress])
  @@index([status])
}

/// Off-chain invitation to a circle. On-chain is open (anyone can join), so an
/// Invite gates the *UI/attribution*, never the contract. Two kinds:
///  - LINK: one reusable link per circle the creator shares with a group.
///  - EMAIL: one token per invited email, sent via Resend at creation time.
/// Validity is capacity-bounded: a LINK/EMAIL token is only "valid" while the
/// circle still has open seats (indexed member count < Circle.seats and the
/// circle is still FILLING). Computed at validation time — no counter to drift.
enum InviteKind {
  LINK
  EMAIL
}

enum InviteStatus {
  PENDING
  CONSUMED
  REVOKED
}

model Invite {
  id            String       @id @default(cuid())
  /// URL-safe random token (crypto.randomBytes(24).toString('base64url')). Unique.
  token         String       @unique
  circle        Circle       @relation(fields: [circleAddress], references: [address], onDelete: Cascade)
  circleAddress String
  kind          InviteKind
  /// Present for EMAIL invites; null for the general LINK.
  email         String?
  /// Creator's lowercased wallet address (the only role allowed to invite).
  invitedBy     String
  status        InviteStatus @default(PENDING)
  /// Lowercased address that consumed it, set on first join via the link.
  consumedBy    String?
  consumedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([circleAddress])
  @@index([email])
}

/// Singleton-ish cursor for the factory scan (new CircleCreated events), so the
/// indexer knows where to resume without rescanning from the deploy block.
model IndexerCursor {
  id               String   @id
  lastIndexedBlock BigInt   @default(0)
  updatedAt        DateTime @updatedAt
}
